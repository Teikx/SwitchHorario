# ========================================================
# Variables de Entorno para SwitchHorario
# ========================================================
# Si estas variables no se configuran, la app funciona
# automáticamente en Modo Local (localStorage en el navegador).
#
# Para conectar con Supabase (100% gratuito):
# 1. Crea un proyecto gratis en https://supabase.com
# 2. Ve a Project Settings -> API
# 3. Copia el Project URL y el anon/public key:

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui
